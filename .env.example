# Safe to expose in the browser. Find these in Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret: server jobs and trusted administrative operations only.
# Never prefix this variable with NEXT_PUBLIC_ or use it in client components.
SUPABASE_SECRET_KEY=

# Server-only secrets for Vercel Cron and manual administrative job runs.
CRON_SECRET=
JOBS_ADMIN_SECRET=

# Performance calculation assumptions used by scheduled jobs.
RISK_FREE_RATE_ANNUAL=0.04
MINIMUM_ACCEPTABLE_RETURN_ANNUAL=0

# Optional outside Vercel. Vercel automatically exposes VERCEL_GIT_COMMIT_SHA.
NEXT_PUBLIC_APP_VERSION=
