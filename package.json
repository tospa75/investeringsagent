    "filter:funds": "node --env-file-if-exists=.env.local --import tsx scripts/filter-funds.ts",
    "validate:filters": "node --env-file-if-exists=.env.local --import tsx scripts/finalize-filter-report.ts",
    "enrich:management-style": "node --env-file-if-exists=.env.local --import tsx scripts/enrich-management-style.ts",
