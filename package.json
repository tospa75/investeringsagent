    "validate:ui:rls": "node --env-file-if-exists=.env.local --import tsx scripts/validate-ui-rls.ts",
    "validate:ui:integration": "node --env-file-if-exists=.env.local --import tsx scripts/validate-ui-integration.ts",
    "validate:workflow:e2e": "node --env-file-if-exists=.env.local --import tsx scripts/validate-workflow-e2e.ts",
